{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.exclude": {
    "node_modules": true,
    "dist": true
  },
  "search.exclude": {
    "public/media": true,
    "src/data/media.json": true
  },
  "emmet.includeLanguages": { "javascript": "html" },
  "cSpell.language": "en,de"
}
